# Discord bot token from https://discord.com/developers/applications
MYINSTANTS_BOT_TOKEN=

# Environment: dev or prod. Prod requires MYINSTANTS_PII_HASH_KEY.
MYINSTANTS_ENV=dev

# Sync slash commands only to this guild during development.
# Leave empty and set MYINSTANTS_SYNC_GLOBAL=true for a global sync.
MYINSTANTS_DEV_GUILD_ID=

# Persistence.
MYINSTANTS_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# HMAC-SHA256 key for hashing user/guild IDs before persistence.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MYINSTANTS_PII_HASH_KEY=

# Logging: pretty for dev, json for prod.
MYINSTANTS_LOG_FORMAT=pretty
MYINSTANTS_LOG_LEVEL=INFO

# Optional: Sentry error tracking.
MYINSTANTS_SENTRY_DSN=
